inventario = []

def agregar_producto():
    # Le pedimos al usuario el mombre del producto que desea agregar.
    nombre_producto = input("Nombre del producto: ")

    for producto in inventario:
        if producto["nombre"].lower() == nombre_producto.lower():
            print(f"El producto '{nombre_producto}' ya existe en el inventario.")
            return

    # Una vez obtenido el precio lo convertimos a decimal con el float.
    precio_producto = float(input("Precio del producto: "))

    if precio_producto <= 0: # Damos la regla que el producto debe costar más de 0.
        print("El precio debe ser mayor a 0. Producto no agregado.")
        return

    cantidad_producto = int(input("Cantidad inicial en stock: "))

    # Se crea el diccionario para el nuevo producto.
    nuevo_producto = {
        "nombre": nombre_producto,
        "precio": precio_producto,
        "cantidad": cantidad_producto
    }
    # Se agrega a la lista.
    inventario.append(nuevo_producto)

   
    print(f"Producto agregado: {nombre_producto} | Precio: {precio_producto} | Cantidad: {cantidad_producto}")


def consultar_inventario():
    print("\n--- INVENTARIO COMPLETO (FERRETERÍA) ---")
    
    # Si el inventario está vacío, avisa y detiene la función
    if not inventario: 
        print("El inventario está vacío. Aún no hay productos registrados.")
        return 
   
    # Títulos de las columnas usando tabuladores (\t)
    print("Producto\t\tPrecio\t\tStock")
    print("-" * 48)
    
    # Recorremos cada producto guardado en la lista
    for producto in inventario:
        nombre = producto["nombre"]
        precio = round(producto["precio"], 2) # Redondeamos a 2 decimales
        cantidad = producto["cantidad"]
        
        # Imprimimos los datos en formato de tabla
        print(f"{nombre}\t\t${precio}\t\t{cantidad}")
        
    print("-" * 48)


def buscar_producto():
    print("\n--- BUSCAR PRODUCTO ---")

    nombre = input("Ingresa el nombre del producto: ")

    if nombre in inventario:
        datos = inventario[nombre]

        print("\nProducto encontrado:")
        print(f"Nombre: {nombre}")
        print(f"Precio: ${datos['precio']:.2f}")
        print(f"Stock: {datos['cantidad']}")

    else:
        print(f"El producto '{nombre}' no se encontró.")




