    def reporte_stock_bajo():
    print("\n--- REPORTE DE STOCK BAJO ---")

    limite_stock = 5
    productos_bajos = False

    for nombre, datos in inventario.items():

        if datos["cantidad"] <= limite_stock:

            print(f"{nombre} Stock: {datos['cantidad']}")

            productos_bajos = True

    if not productos_bajos:
        print("No hay productos en stock bajas !!")
